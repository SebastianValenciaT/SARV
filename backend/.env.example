# Copia este archivo como .env y cambia los valores. Nunca subas el .env a git.
# SECRET_KEY firma las sesiones y los tokens JWT: mínimo 32 caracteres aleatorios
# (con menos, PyJWT muestra InsecureKeyLengthWarning). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Con DEBUG=False el servidor no arranca si se deja este valor de ejemplo.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Si quitas las variables DB_*, Django usa SQLite (db.sqlite3).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sarv
DB_USER=sarv_user
DB_PASSWORD=tu_contraseña
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- Producción (Render) ---
# Estas variables se definen en el panel de Render, no en este archivo:
#   DEBUG=False
#   DATABASE_URL=...            (si existe, sustituye a las DB_* de arriba)
#   CORS_ALLOWED_ORIGINS=https://<tu-sitio-estatico>.onrender.com
#   NOMINATIM_USER_AGENT=SARV/1.0 (tu-correo@dominio.com)
#   DJANGO_SUPERUSER_EMAIL / DJANGO_SUPERUSER_PASSWORD   (opcional, crea el admin)
# Render ya aporta RENDER_EXTERNAL_HOSTNAME; settings.py lo añade a ALLOWED_HOSTS.
